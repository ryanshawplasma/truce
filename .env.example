# Copy this file to .env.local for local development, and paste the same values
# into Vercel → Project → Settings → Environment Variables when you deploy.
# Truce runs fine with none of them set — it just falls back to self-contained links.

# Your Supabase project URL. Supabase dashboard → Project Settings → Data API → Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role key (Project Settings → API Keys). SECRET — it bypasses all database rules, so never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public address of your site, used to build share links. No trailing slash. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Optional but recommended. A long random string of your own invention. It does two jobs:
# it unlocks the private stats page at /dev?key=..., and it signs the "Our corner" session
# cookie. Unset, /dev stays closed to everybody and corner sessions fall back to a key
# derived from your service-role key (which works, but signs everyone out if you rotate it).
ADMIN_SECRET=make-up-something-long-and-random

# ---------------------------------------------------------------------------
# Optional: a shared rate-limit counter.
# ---------------------------------------------------------------------------
# Without these, rate limiting counts in each serverless instance's own memory.
# That is a speed bump: Vercel runs many instances, so somebody spreading
# requests across them gets a much higher effective limit, and a cold start
# forgets everything. It is enough for normal traffic and it is what the site
# has always done.
#
# With these, every instance increments the same counter, so the limit is the
# limit — which is what actually stops a password-guessing run against a corner.
#
# Free to set up: upstash.com -> Create Database -> Redis -> copy the two REST
# values from the database page. Nothing else changes; the code falls back to
# the in-memory counter on its own if Redis is slow or unreachable.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
