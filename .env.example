# Copy this file to .env.local for local development, and paste the same three
# values into Vercel → Project → Settings → Environment Variables when you deploy.
# Truce runs fine with none of them set — it just falls back to self-contained links.

# Your Supabase project URL. Supabase dashboard → Project Settings → Data API → Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role key (Project Settings → API Keys). SECRET — it bypasses all database rules, so never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public address of your site, used to build share links. No trailing slash. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
